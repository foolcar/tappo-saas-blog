---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  date?: Date;
  updated?: Date;
  category?: string;
  tags?: string[];
  slug?: string;
  wordCount?: number;
  breadcrumbs?: { name: string; url?: string }[];
  locale?: 'zh-Hant' | 'en';
  alternateUrl?: string;
  enSlug?: string;
  zhSlug?: string;
  pageType?: 'page' | 'about';
}

const {
  title, description, image = '/og-default.png', type = 'website', date, updated,
  category, tags = [], slug, wordCount, breadcrumbs,
  locale = 'zh-Hant', alternateUrl, enSlug, zhSlug, pageType = 'page',
} = Astro.props;

const siteTitle = locale === 'en' ? 'Restaurant SaaS Global Expansion Insight' : '餐飲 SaaS 出海觀察';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const siteUrl = Astro.site?.origin ?? 'https://blog.foolcar.cc';
const basePath = siteUrl;
const pageUrl = Astro.url.toString();
const imageUrl = image.startsWith('http') ? image : `${basePath}${image}`;

// Preview guard: blogdemo.foolcar.cc is the test station and must stay out of search indexes.
// Prod (blog.foolcar.cc) never triggers this.
const isPreview = Astro.site?.hostname === 'blogdemo.foolcar.cc';

// Compute language toggle URL — relative path so the local preview stays on localhost.
// Prefer the page's `alternateUrl` (strip origin → relative) so non-article pages
// (home, about) switch to their exact bilingual counterpart; fall back to slug logic
// for articles, and to home for pages without a counterpart (category/tags/404).
// hreflang still uses the absolute `alternateUrl` above — this is only the in-page switch.
const langToggleUrl = (() => {
  if (alternateUrl) {
    const rel = alternateUrl.replace(basePath, '');
    return rel || '/';
  }
  return locale === 'en'
    ? (zhSlug ? `/blog/${zhSlug}/` : '/')
    : (enSlug ? `/en/blog/${enSlug}/` : '/en/');
})();
---

<!DOCTYPE html>
<html lang={locale === 'en' ? 'en' : 'zh-Hant'}>
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="D68PPCqBjgUyTa5SWCl5o2OjkMg9jFDP7hTvPfltgRM" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {isPreview && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />}
  {isPreview && <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />}

  <!-- Primary Meta -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="阿公" />
  <link rel="canonical" href={pageUrl} />

  <!-- Hreflang — auto-generated from props -->
  {
    (() => {
      const zhHref = locale === 'zh-Hant'
        ? pageUrl
        : (alternateUrl || (slug && zhSlug ? `${basePath}/blog/${zhSlug}/` : null));
      const enHref = locale === 'en'
        ? pageUrl
        : (alternateUrl || (slug && enSlug ? `${basePath}/en/blog/${enSlug}/` : null));

      if (zhHref && enHref) {
        return <>
          <link rel="alternate" hreflang="zh-Hant" href={zhHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={zhHref} />
        </>;
      }
      if (zhHref) {
        return <>
          <link rel="alternate" hreflang="zh-Hant" href={zhHref} />
          <link rel="alternate" hreflang="x-default" href={zhHref} />
        </>;
      }
      if (enHref) {
        return <>
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={enHref} />
        </>;
      }
      return null;
    })()
  }

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:site_name" content={siteTitle} />
  <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_Hant'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  {
    type === 'article' && date ? (
      <>
        <meta property="article:published_time" content={date.toISOString()} />
        <meta property="article:modified_time" content={(updated || date).toISOString()} />
        <meta property="article:author" content="阿公" />
        {category && <meta property="article:section" content={category} />}
        {tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    ) : null
  }

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <!-- BreadcrumbList Structured Data -->
  {
    breadcrumbs && breadcrumbs.length > 0 ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          ...(b.url ? { item: b.url } : {}),
        })),
      })} />
    ) : null
  }

  <!-- Structured Data -->
  {
    type === 'article' ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        image: imageUrl,
        datePublished: date?.toISOString(),
        dateModified: (updated || date)?.toISOString(),
        inLanguage: locale === 'en' ? 'en' : 'zh-Hant',
        author: {
          '@type': 'Person',
          name: '阿公',
          url: 'https://blog.foolcar.cc',
        },
        publisher: {
          '@type': 'Organization',
          name: siteTitle,
        },
        url: pageUrl,
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': pageUrl,
        },
        ...(category ? { articleSection: category } : {}),
        ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
        ...(wordCount ? { wordCount } : {}),
      })} />
    ) : pageType === 'about' ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'AboutPage',
        name: title,
        description: description,
        url: pageUrl,
        inLanguage: locale === 'en' ? 'en' : 'zh-Hant',
        about: {
          '@type': 'Person',
          name: locale === 'en' ? 'Ah Gung (阿公)' : '阿公',
          description: description,
          url: 'https://blog.foolcar.cc',
          sameAs: [
            'https://github.com/foolcar',
            'https://www.linkedin.com/in/ravicli/',
          ],
        },
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteTitle,
        url: siteUrl,
        description: description,
        inLanguage: locale === 'en' ? 'en' : 'zh-Hant',
        author: {
          '@type': 'Person',
          name: '阿公',
          url: 'https://blog.foolcar.cc',
        },
      })} />
    )
  }

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-RPXX86P33G"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-RPXX86P33G');
  </script>

  <!-- Ahrefs Analytics -->
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="gkivmb3fm+jULNp4i0mgkw" async></script>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  {type === 'article' && <div id="reading-progress" aria-hidden="true"></div>}
  <header class="site-header">
    <a class="brand" href={locale === 'en' ? '/en/' : '/'} aria-label={locale === 'en' ? 'Home' : '首頁'}>
      {locale === 'en' ? 'Restaurant SaaS Global Expansion Insight' : <Fragment>餐飲 <span>SaaS</span> 出海觀察</Fragment>}
    </a>
    <nav aria-label={locale === 'en' ? 'Main navigation' : '主要導覽'}>
      <a href={locale === 'en' ? '/en/' : '/'}>{locale === 'en' ? 'Articles' : '文章'}</a>
      <a href={locale === 'en' ? '/en/#thinking' : '/#thinking'}>{locale === 'en' ? 'Watching' : '正在關注'}</a>
      <a href={locale === 'en' ? '/en/about/' : '/about/'}>{locale === 'en' ? 'About' : '關於'}</a>
    </nav>
    <a class="language" href={langToggleUrl}><b>{locale === 'en' ? 'EN' : '中'}</b> / {locale === 'en' ? '中' : 'EN'}</a>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <a class="brand" href={locale === 'en' ? '/en/' : '/'}>{siteTitle}</a>
    <p>{locale === 'en' ? 'Global F&B brands and digital operations' : '餐飲品牌全球化與數字營運觀察'}</p>
    <nav>
      <a href={locale === 'en' ? '/en/' : '/'}>{locale === 'en' ? 'Articles' : '文章'}</a>
      <a href={locale === 'en' ? '/en/about/' : '/about/'}>{locale === 'en' ? 'About' : '關於'}</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </nav>
  </footer>
  <script is:inline>
    const bar = document.getElementById('reading-progress');
    if (bar) addEventListener('scroll', () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.width = `${max > 0 ? scrollY / max * 100 : 0}%`;
    }, { passive: true });
  </script>
</body>
</html>
