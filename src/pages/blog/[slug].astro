---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Look up English version for hreflang cross-links
const enPosts = await getCollection('blogEn', ({ data }) => !data.draft);
const enMatch = enPosts.find(p => p.data.originalSlug === post.slug);
const enSlug = enMatch?.slug;

// Compute word count for Schema
const wordCount = post.body?.match(/[\u4e00-\u9fff]|[a-zA-Z]+/g)?.length ?? 0;
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  date={post.data.date}
  updated={post.data.updated}
  category={post.data.category}
  tags={post.data.tags}
  slug={post.slug}
  image={post.data.image || '/og-default.png'}
  wordCount={wordCount}
  enSlug={enSlug}
  breadcrumbs={[
    { name: '首頁', url: 'https://blog.foolcar.cc/' },
    { name: post.data.category, url: `https://blog.foolcar.cc/category/${encodeURIComponent(post.data.category)}/` },
    { name: post.data.title },
  ]}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- 文章頭部 -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
          {post.data.category}
        </span>
        {post.data.tags.map((tag) => (
          <a href={`${import.meta.env.BASE_URL}tags/${tag.replace(/\//g, '-')}/`}
             class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded hover:bg-blue-100 hover:text-blue-600 transition-colors cursor-pointer">
            {tag}
          </a>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mb-4">
        {post.data.title}
      </h1>

      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        {post.data.description}
      </p>

      <div class="flex items-center gap-4 text-sm text-gray-500 border-b border-gray-200 pb-6">
        <time datetime={post.data.date.toISOString().split('T')[0]}>
          發佈於 {post.data.date.toLocaleDateString('zh-Hant', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.updated && (
          <time datetime={post.data.updated.toISOString().split('T')[0]}>
            · 更新於 {post.data.updated.toLocaleDateString('zh-Hant', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        )}
      </div>
    </header>

    <!-- 文章內容 -->
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <footer class="article-footer">
      <aside class="article-author-note" aria-label="關於作者">
        <img src="/about-author-illustration.jpg" alt="作者在中餐廳記錄營運觀察的手繪插畫" />
        <div>
          <p class="author-label">關於作者</p>
          <p>我長期參與餐飲軟件、門店營運與產品設計。這裡的文章整理第一線經驗、公開資料，以及仍值得繼續追問的問題。</p>
          <a class="text-link" href="/about/">更多關於我</a>
        </div>
      </aside>

      <nav class="article-footer-nav" aria-label="文章頁延伸連結">
        <a class="text-link" href={`${import.meta.env.BASE_URL}`}>返回文章列表</a>
        <a class="text-link" href="/rss.xml">RSS 訂閱</a>
      </nav>
    </footer>
  </article>
</BlogLayout>
