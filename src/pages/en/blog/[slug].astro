---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import Comments from '../../../components/Comments.tsx';
import { getCollection } from 'astro:content';
import { topics } from '../../../data/topics';

export async function getStaticPaths() {
  const posts = await getCollection('blogEn', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Compute word count
const wordCount = post.body?.match(/[a-zA-Z]+/g)?.length ?? 0;

// Backlinks to the pillar pages this article belongs to.
// EN filenames can differ from CN (e.g. multi-platform-delivery-how-en),
// so match against originalSlug, NOT post.slug.
const topicLinks = topics
  .filter((t) => t.en.articles.includes(post.data.originalSlug ?? ''))
  .map((t) => ({ title: t.en.title, url: `/en/topics/${t.slug}/` }));
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  date={post.data.date}
  updated={post.data.updated}
  category={post.data.category}
  tags={post.data.tags}
  slug={post.slug}
  image={post.data.image || '/og-default.png'}
  faq={post.data.faq}
  wordCount={wordCount}
  locale="en"
  zhSlug={post.data.originalSlug}
  breadcrumbs={[
    { name: 'Home', url: 'https://blog.foolcar.cc/en/' },
    ...(topicLinks.length > 0
      ? [{ name: topicLinks[0].title, url: `https://blog.foolcar.cc${topicLinks[0].url}` }]
      : []),
    { name: post.data.title },
  ]}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Article Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-sm font-medium text-blue-600 bg-blue-50 px-3 py-1 rounded-full">
          {post.data.category}
        </span>
        {post.data.tags.map((tag) => (
          <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">
            {tag}
          </span>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mb-4">
        {post.data.title}
      </h1>

      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        {post.data.description}
      </p>

      <div class="flex items-center gap-4 text-sm text-gray-500 border-b border-gray-200 pb-6">
        <time datetime={post.data.date.toISOString().split('T')[0]}>
          {post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.data.updated && (
          <time datetime={post.data.updated.toISOString().split('T')[0]}>
            · Updated {post.data.updated.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        )}
      </div>
    </header>

    <!-- Article Content -->
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    {topicLinks.length > 0 && (
      <aside class="article-topics" aria-label="Article topics">
        <p class="article-topics-label">Part of</p>
        <div class="article-topics-links">
          {topicLinks.map((t) => (
            <a href={t.url}>{t.title}</a>
          ))}
        </div>
      </aside>
    )}

    <Comments client:load threadKey={post.data.originalSlug} locale="en" />

    <footer class="article-footer">
      <aside class="article-author-note" aria-label="About the author">
        <img src="/about-author-illustration.jpg" alt="Editorial illustration of the author taking notes in a Chinese restaurant" />
        <div>
          <p class="author-label">About the author</p>
          <p>I work across restaurant software, store operations, and product design. These articles bring together first-hand experience, public evidence, and questions that remain worth examining.</p>
          <a class="text-link" href="/en/about/">More about me</a>
        </div>
      </aside>

      <nav class="article-footer-nav" aria-label="More from this article">
        <a class="text-link" href={`${import.meta.env.BASE_URL}en/`}>Back to articles</a>
        <a class="text-link" href="/en/rss.xml">RSS feed</a>
      </nav>
    </footer>
  </article>
</BlogLayout>
