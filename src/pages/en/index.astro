---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogEn', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts[0];
const recent = posts.slice(1, 7);
const cleanDashes = (text: string) => text.replace(/\s*[—–]\s*/g, ' - ');

// Curated homepage topic pillars (P1 SEO). Article picks are editor's choices,
// "Read more" links to a pillar page (not a bare tag index).
const bySlug = Object.fromEntries(posts.map((p) => [p.slug, p]));
const pick = (slugs: string[]) => slugs.map((s) => bySlug[s]).filter(Boolean);
const topics = [
  {
    title: 'Restaurant Data Platform & System Architecture',
    intro: 'From POS data decoupling and the boundary of a light POS to when a data hub pays off — how groups should layer systems so the store stays light and HQ stays clear.',
    moreUrl: '/en/topics/restaurant-data-platform/',
    moreText: 'More on data platform',
    posts: pick([
      '2026-09-22-data-hub-when-needed',
      '2026-09-07-data-decoupling-restaurant-group',
      '2026-09-14-lightweight-pos-responsibility-boundaries',
      '2026-10-13-ai-not-in-pos',
    ]),
  },
  {
    title: 'Restaurant SaaS Overseas Markets & Localization',
    intro: 'From a Hong Kong tea restaurant to overseas tables: product design, payments, compliance, and localization when a restaurant SaaS crosses markets.',
    moreUrl: '/en/topics/overseas-restaurant-saas/',
    moreText: 'More on overseas markets',
    posts: pick([
      '2026-10-06-canada-market-challenges',
      '2026-04-15-first-stop-southeast-asia',
      '2026-05-27-global-fb-saas-landscape',
      '2026-03-12-overseas-pos-product-design',
    ]),
  },
  {
    title: 'AI in Restaurant Operations & SaaS',
    intro: 'AI does not belong in the POS, and should not be only a chatbot. Where AI should sit, how it amplifies managers, and how reviews become operational data.',
    moreUrl: '/en/topics/restaurant-ai/',
    moreText: 'More on AI in restaurants',
    posts: pick([
      '2026-08-31-ai-in-restaurant-saas-product',
      '2026-10-13-ai-not-in-pos',
      '2026-07-20-ai-for-saas-overseas-team',
      '2026-08-17-online-review-reputation-operation',
    ]),
  },
];
---

<BlogLayout
  title="Restaurant SaaS Global Expansion Insight"
  description="Independent notes on restaurant brands, F&B SaaS, international expansion, and digital operations."
  type="website"
  locale="en"
  alternateUrl="https://blog.foolcar.cc/"
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Restaurant SaaS Global Expansion Insight</p>
      <h1>Going global is more than opening another restaurant.</h1>
      <p class="hero-lede">Notes on the real operating questions that appear when restaurant brands and software enter new markets.</p>
      <a class="text-link" href="#articles">Read the latest</a>
    </div>
    <figure class="hero-photo">
      <picture>
        <source type="image/avif" srcset="/img/restaurant-interior-640.avif 640w, /img/restaurant-interior-960.avif 960w, /img/restaurant-interior-1280.avif 1280w" sizes="(max-width: 768px) 100vw, 50vw" />
        <source type="image/webp" srcset="/img/restaurant-interior-640.webp 640w, /img/restaurant-interior-960.webp 960w, /img/restaurant-interior-1280.webp 1280w" sizes="(max-width: 768px) 100vw, 50vw" />
        <img src="/img/restaurant-interior-1280.jpg" width="1280" height="853" fetchpriority="high" decoding="async" alt="A quiet modern restaurant before service begins" />
      </picture>
      <figcaption>Technology matters when it helps an ordinary restaurant shift run better.</figcaption>
    </figure>
  </section>

  <section class="home-section" id="articles">
    <p class="section-kicker">Selected article</p>
    <article class="featured-story">
      <div>
        <p class="article-meta">
          <span>{featured.data.category}</span>
          <time datetime={featured.data.date.toISOString().split('T')[0]}>
            {featured.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
          </time>
        </p>
        <h2><a href={`/en/blog/${featured.slug}/`}>{cleanDashes(featured.data.title)}</a></h2>
        <p>{cleanDashes(featured.data.description)}</p>
        <a class="text-link" href={`/en/blog/${featured.slug}/`}>Read article</a>
      </div>
      <a href={`/en/blog/${featured.slug}/`} aria-label={cleanDashes(featured.data.title)}>
        <img src="/restaurant-counter.jpg" alt="A restaurant counter and open kitchen being prepared for service" width="1400" height="933" loading="lazy" />
      </a>
    </article>
  </section>

  <section class="home-section latest">
    <h2>Recent writing</h2>
    <div class="editorial-list">
      {recent.map((post) => (
        <article>
          <span class="category">{post.data.category}</span>
          <div>
            <h3><a href={`/en/blog/${post.slug}/`}>{cleanDashes(post.data.title)}</a></h3>
            <p>{cleanDashes(post.data.description)}</p>
          </div>
          <time datetime={post.data.date.toISOString().split('T')[0]}>
            {post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
          </time>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section pillars" id="topics">
    <p class="section-kicker">Core topics</p>
    <h2>Three directions we keep returning to</h2>
    {topics.map((t) => (
      <div class="pillar">
        <div class="pillar-head">
          <h3>{t.title}</h3>
          <p>{t.intro}</p>
        </div>
        <div class="pillar-list">
          {t.posts.map((post) => (
            <article>
              <div>
                <h3><a href={`/en/blog/${post.slug}/`}>{cleanDashes(post.data.title)}</a></h3>
                <p>{cleanDashes(post.data.description)}</p>
              </div>
              <time datetime={post.data.date.toISOString().split('T')[0]}>
                {post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
              </time>
            </article>
          ))}
        </div>
        <a class="text-link" href={t.moreUrl}>{t.moreText}</a>
      </div>
    ))}
  </section>

  <section class="home-section thinking" id="thinking">
    <img src="/restaurant-service.jpg" alt="A restaurant team serving dishes during an ordinary shift" width="1400" height="933" loading="lazy" />
    <div>
      <h2>Questions I am following</h2>
      <p>There are no standard answers yet. These are the questions I will keep returning to.</p>
      <ol>
        <li><span>01</span>How many local systems should an overseas restaurant connect?</li>
        <li><span>02</span>Can head-office standards coexist with local autonomy?</li>
        <li><span>03</span>Should restaurant data serve operations or reporting first?</li>
      </ol>
    </div>
  </section>

  <section class="home-section about-preview" id="about">
    <figure class="about-preview-photo">
      <img src="/about-author-illustration.jpg" alt="Editorial illustration of the author taking notes in a Chinese restaurant" width="1706" height="1279" loading="lazy" />
      <figcaption>The useful questions usually appear after service begins.</figcaption>
    </figure>
    <div>
      <h2>About this journal</h2>
      <p>I have spent years working across restaurant software, store operations, and product design. This is where I examine the questions that remain after the meetings end. Articles draw on first-hand experience, public sources, and personal judgement. They do not represent any company's official position.</p>
      <a class="text-link" href="/en/about/">More about the journal</a>
    </div>
  </section>

  <aside class="rss-strip">
    <div>
      <strong>Published occasionally</strong>
      <p>New essays, useful reading, and questions that are still unresolved.</p>
    </div>
    <a href="/en/rss.xml">RSS feed</a>
  </aside>
</BlogLayout>
