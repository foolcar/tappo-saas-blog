---
import BlogLayout from '../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts[0];
const recent = posts.slice(1, 7);

// Curated homepage topic pillars (P1 SEO). Article picks are editor's choices,
// "查看更多" links to an indexed core tag page (not a bare tag index).
const bySlug = Object.fromEntries(posts.map((p) => [p.slug, p]));
const pick = (slugs) => slugs.map((s) => bySlug[s]).filter(Boolean);
const topics = [
  {
    title: '餐飲數據中台與系統架構',
    intro: '從 POS 數據解耦、輕 POS 的責任邊界，到什麼時候該上數據中台——這組文章談餐飲集團如何把系統分層，讓門店終端輕、總部看得清。',
    moreUrl: '/topics/restaurant-data-platform/',
    moreText: '更多數據中台文章',
    posts: pick([
      '2026-09-22-data-hub-when-needed',
      '2026-09-07-data-decoupling-restaurant-group',
      '2026-09-14-lightweight-pos-responsibility-boundaries',
      '2026-10-13-ai-not-in-pos',
    ]),
  },
  {
    title: '餐飲 SaaS 出海市場與落地',
    intro: '從中國香港茶餐廳到加拿大餐桌，餐飲 SaaS 出海要面對產品設計、支付、合規與本地化。這裡整理了我們走過幾個市場後，最值得先想清楚的事。',
    moreUrl: '/topics/overseas-restaurant-saas/',
    moreText: '更多出海市場文章',
    posts: pick([
      '2026-10-06-canada-market-challenges',
      '2026-04-15-first-stop-southeast-asia',
      '2026-05-27-global-fb-saas-landscape',
      '2026-03-12-overseas-pos-product-design',
    ]),
  },
  {
    title: 'AI 與門店營運',
    intro: 'AI 不必塞進 POS，也不該只是聊天機器人。這組文章談 AI 在餐飲門店的部署位置、如何用 AI 放大管理效率，以及線上評價如何變成營運數據。',
    moreUrl: '/topics/restaurant-ai/',
    moreText: '更多門店營運文章',
    posts: pick([
      '2026-08-31-ai-in-restaurant-saas-product',
      '2026-10-13-ai-not-in-pos',
      '2026-07-20-ai-for-saas-overseas-team',
      '2026-08-17-online-review-reputation-operation',
    ]),
  },
];
---

<BlogLayout
  title="POS 系統、數據中台與餐飲 AI 實戰觀察"
  description="分享餐飲 SaaS 出海、POS 系統、數據中台、多門店營運、加拿大與亞洲市場，以及 AI 在餐飲門店的實際應用。"
  type="website"
  alternateUrl="https://blog.foolcar.cc/en/"
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">餐飲 SaaS 出海觀察</p>
      <h1>餐飲出海，<br />不只是在海外開一家店。</h1>
      <p class="hero-lede">記錄餐飲品牌、軟件產品與數字營運進入不同市場時，遇到的真實問題。</p>
      <a class="text-link" href="#articles">閱讀最新文章</a>
    </div>
    <figure class="hero-photo">
      <picture>
        <source type="image/avif" srcset="/img/restaurant-interior-640.avif 640w, /img/restaurant-interior-960.avif 960w, /img/restaurant-interior-1280.avif 1280w" sizes="(max-width: 768px) 100vw, 50vw" />
        <source type="image/webp" srcset="/img/restaurant-interior-640.webp 640w, /img/restaurant-interior-960.webp 960w, /img/restaurant-interior-1280.webp 1280w" sizes="(max-width: 768px) 100vw, 50vw" />
        <img src="/img/restaurant-interior-1280.jpg" width="1280" height="853" fetchpriority="high" decoding="async" alt="開業前安靜的現代餐廳空間" />
      </picture>
      <figcaption>系統最終要回到餐廳現場，讓一個普通班次運作得更好。</figcaption>
    </figure>
  </section>

  <section class="home-section" id="articles">
    <p class="section-kicker">精選文章</p>
    <article class="featured-story">
      <div>
        <p class="article-meta"><span>{featured.data.category}</span><time>{featured.data.date.toLocaleDateString('zh-Hant')}</time></p>
        <h2><a href={`/blog/${featured.slug}/`}>{featured.data.title}</a></h2>
        <p>{featured.data.description}</p>
        <a class="text-link" href={`/blog/${featured.slug}/`}>閱讀文章</a>
      </div>
      <a href={`/blog/${featured.slug}/`} aria-label={featured.data.title}>
        <img src="/restaurant-counter.jpg" alt="準備營業的餐廳與開放式廚房" width="1400" height="933" loading="lazy" />
      </a>
    </article>
  </section>

  <section class="home-section latest">
    <h2>最近文章</h2>
    <div class="editorial-list">
      {recent.map((post) => (
        <article>
          <a class="category" href={`/category/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
          <div>
            <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
          <time>{post.data.date.toLocaleDateString('zh-Hant', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
        </article>
      ))}
    </div>
    <a class="text-link list-link" href="/tags/">按主題瀏覽全部文章</a>
  </section>

  <section class="home-section pillars" id="topics">
    <p class="section-kicker">核心主題</p>
    <h2>三個我們持續追問的方向</h2>
    {topics.map((t) => (
      <div class="pillar">
        <div class="pillar-head">
          <h3>{t.title}</h3>
          <p>{t.intro}</p>
        </div>
        <div class="pillar-list">
          {t.posts.map((post) => (
            <article>
              <div>
                <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
              </div>
              <time>{post.data.date.toLocaleDateString('zh-Hant', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
            </article>
          ))}
        </div>
        <a class="text-link" href={t.moreUrl}>{t.moreText}</a>
      </div>
    ))}
  </section>

  <section class="home-section thinking" id="thinking">
    <img src="/restaurant-service.jpg" alt="餐廳服務人員將菜餚送到餐桌" width="1400" height="933" loading="lazy" />
    <div>
      <h2>我正在關注</h2>
      <p>這些問題還沒有標準答案，也是接下來幾篇文章會繼續追問的方向。</p>
      <ol>
        <li><span>01</span>海外門店要接入多少套本地系統？</li>
        <li><span>02</span>總部標準化與市場自主權如何共存？</li>
        <li><span>03</span>餐廳數據應該服務現場，還是服務報表？</li>
      </ol>
    </div>
  </section>

  <section class="home-section about-preview" id="about">
    <figure class="about-preview-photo">
      <img src="/about-author-illustration.jpg" alt="作者在中餐廳記錄營運觀察的手繪插畫" width="1706" height="1279" loading="lazy" />
      <figcaption>真正值得討論的問題，通常發生在餐廳開始營業之後。</figcaption>
    </figure>
    <div>
      <h2>關於這個 Blog</h2>
      <p>我長期參與餐飲軟件、門店營運與產品設計。這裡用來整理工作之外仍想繼續追問的問題。文章來自第一線經驗、公開資料與個人判斷，不代表任何公司的正式立場。</p>
      <a class="text-link" href="/about/">更多關於我</a>
    </div>
  </section>

  <aside class="rss-strip">
    <div><strong>不定期更新</strong><p>新文章、近期讀到的資料，以及仍未想明白的問題。</p></div>
    <a href="/rss.xml">RSS 訂閱</a>
  </aside>
</BlogLayout>
