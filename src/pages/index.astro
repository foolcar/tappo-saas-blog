---
import BlogLayout from '../layouts/BlogLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts[0];
const recent = posts.slice(1, 7);
---

<BlogLayout
  title="餐飲SaaS出海指南"
  description="餐飲品牌全球化、餐飲 SaaS 出海與數字營運觀察。"
  type="website"
  alternateUrl="https://blog.foolcar.cc/en/"
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">F&amp;B SaaS Going Global</p>
      <h1>餐飲出海，<br />不只是在海外開一家店。</h1>
      <p class="hero-lede">記錄餐飲品牌、軟件產品與數字營運進入不同市場時，遇到的真實問題。</p>
      <a class="text-link" href="#articles">閱讀最新文章</a>
    </div>
    <figure class="hero-photo">
      <img src="/restaurant-interior.jpg" alt="開業前安靜的現代餐廳空間" />
      <figcaption>系統最終要回到餐廳現場，讓一個普通班次運作得更好。</figcaption>
    </figure>
  </section>

  <section class="home-section" id="articles">
    <p class="section-kicker">精選文章</p>
    <article class="featured-story">
      <div>
        <p class="article-meta"><span>{featured.data.category}</span><time>{featured.data.date.toLocaleDateString('zh-Hant')}</time></p>
        <h2><a href={`/blog/${featured.slug}/`}>{featured.data.title}</a></h2>
        <p>{featured.data.description}</p>
        <a class="text-link" href={`/blog/${featured.slug}/`}>閱讀文章</a>
      </div>
      <a href={`/blog/${featured.slug}/`} aria-label={featured.data.title}>
        <img src="/restaurant-counter.jpg" alt="準備營業的餐廳與開放式廚房" />
      </a>
    </article>
  </section>

  <section class="home-section latest">
    <h2>最近文章</h2>
    <div class="editorial-list">
      {recent.map((post) => (
        <article>
          <a class="category" href={`/category/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
          <div>
            <h3><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
          </div>
          <time>{post.data.date.toLocaleDateString('zh-Hant', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
        </article>
      ))}
    </div>
    <a class="text-link list-link" href="/tags/">按主題瀏覽全部文章</a>
  </section>

  <section class="home-section thinking" id="thinking">
    <img src="/restaurant-service.jpg" alt="餐廳服務人員將菜餚送到餐桌" />
    <div>
      <h2>我正在關注</h2>
      <p>這些問題還沒有標準答案，也是接下來幾篇文章會繼續追問的方向。</p>
      <ol>
        <li><span>01</span>海外門店要接入多少套本地系統？</li>
        <li><span>02</span>總部標準化與市場自主權如何共存？</li>
        <li><span>03</span>餐廳數據應該服務現場，還是服務報表？</li>
      </ol>
    </div>
  </section>

  <section class="home-section about-preview" id="about">
    <figure class="about-preview-photo">
      <img src="/about-author-illustration.jpg" alt="作者在中餐廳記錄營運觀察的手繪插畫" />
      <figcaption>真正值得討論的問題，通常發生在餐廳開始營業之後。</figcaption>
    </figure>
    <div>
      <h2>關於這個 Blog</h2>
      <p>我長期參與餐飲軟件、門店營運與產品設計。這裡用來整理工作之外仍想繼續追問的問題。文章來自第一線經驗、公開資料與個人判斷，不代表任何公司的正式立場。</p>
      <a class="text-link" href="/about/">更多關於我</a>
    </div>
  </section>

  <aside class="rss-strip">
    <div><strong>不定期更新</strong><p>新文章、近期讀到的資料，以及仍未想明白的問題。</p></div>
    <a href="/rss.xml">RSS 訂閱</a>
  </aside>
</BlogLayout>
